# 复制为 .env 后按需修改
DATABASE_URL=postgresql+psycopg://ivi:ivi@localhost:5432/ivi_test

# 生产必须换掉：openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Appium 脚本回传结果时用的静态令牌（不走 JWT）
AUTOMATION_TOKEN=dev-automation-token

# 留空则 AI 生成走规则模板降级，不报错
# 任意 OpenAI 兼容网关均可，例如 DeepSeek: https://api.deepseek.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat

SEED_ON_STARTUP=true
